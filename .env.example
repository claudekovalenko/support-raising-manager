# ---- Required ----
DATABASE_URL="file:./dev.db"
# Public URL of the site (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"
# Comma-separated emails that get the admin dashboard when they log in
ADMIN_EMAILS="you@example.com"

# ---- Email (optional; without it, emails are printed to the server console) ----
# https://resend.com — verify your domain, then:
RESEND_API_KEY=""
EMAIL_FROM="The Kovalenkos <updates@yourdomain.org>"

# ---- Text messages (optional) ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ---- Online giving (optional; without it, pledges are recorded and you track gifts manually) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
